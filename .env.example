# Copy to .env for local development. Auto-loaded by the backend.
#
# Cloudflare Turnstile — official test keys (safe for dev only)
# - Secret test key: 1x0000000000000000000000000000000AA

# enforce | log-only | disabled
TURNSTILE_MODE=enforce

# Cloudflare Turnstile secret (test key for local dev)
# 1x0000000000000000000000000000000AA Always passes
# 2x0000000000000000000000000000000AA Always fails
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional: restrict valid hostnames for Turnstile verification
# For local development is usually best to leave empty
# TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1

# Optional: assert expected action (set in the widget)
# TURNSTILE_EXPECTED_ACTION=

# Networking/perf knobs
TURNSTILE_TIMEOUT_MS=2000
TURNSTILE_CACHE_TTL_SECONDS=240
TURNSTILE_BIND_CACHE_TO_IP_UA=true

# Optional server settings (env equivalents for CLI flags via viper)
# AZTEC_P2P_EXPLORER_BIND_ADDR=:8080
# AZTEC_P2P_EXPLORER_DB_DSN=postgres://explorer:explorer@localhost:15432/explorer?sslmode=disable

# RPC URL for the Aztec node (required)
AZTEC_P2P_EXPLORER_RPC_URL=