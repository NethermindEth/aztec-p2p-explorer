{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm lint && tsc && vite build",
    "local-dev": "./start-local-dev.sh",
    "tsc": "tsc",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 10",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write .",
    "prepare": "cd .. && husky ./frontend/.husky"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,scss,css}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.0.20",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/themes": "^3.3.0",
    "@react-spring/three": "^9.7.3",
    "@react-three/drei": "^9.111.5",
    "@react-three/fiber": "^8.17.6",
    "chart.js": "^4.4.3",
    "density-clustering": "^1.3.0",
    "jotai": "^2.12.4",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "6.21.3",
    "react-simple-maps": "^3.0.0",
    "swr": "^2.3.3",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.6",
    "@storybook/addon-essentials": "^8.2.8",
    "@storybook/addon-interactions": "^8.2.8",
    "@storybook/addon-links": "^8.2.8",
    "@storybook/addon-onboarding": "^8.2.8",
    "@storybook/blocks": "^8.2.8",
    "@storybook/preset-create-react-app": "^8.2.8",
    "@storybook/react": "^8.2.8",
    "@storybook/react-vite": "^8.2.8",
    "@storybook/test": "^8.2.8",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.3.2",
    "@types/density-clustering": "^1.3.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.15.19",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.2.22",
    "@types/react-simple-maps": "^3.0.6",
    "@types/three": "^0.165.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^0.12.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.4",
    "postcss": "^8.5.5",
    "prettier": "^3.3.3",
    "storybook": "^8.2.8",
    "typescript": "^5.8.3",
    "uuid": "^13.0.0",
    "vite": "^6.4.3",
    "vite-plugin-checker": "^0.9.3",
    "vite-plugin-svgr": "^4.2.0"
  },
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "overrides": {
      "d3-color@<3.1.0": ">=3.1.0",
      "postcss@<8.4.31": ">=8.4.31",
      "nth-check@<2.0.1": ">=2.0.1",
      "esbuild@<=0.24.2": ">=0.25.0",
      "webpack-dev-server@<=5.2.0": ">=5.2.1"
    }
  }
}
